## syntax=docker/dockerfile:1.7

FROM node:24-bookworm AS frontend-build

WORKDIR /app

ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.json tsconfig.node.json vite.config.ts postcss.config.js tailwind.config.js index.html ./
COPY frontend ./frontend
COPY public ./public

RUN corepack enable && corepack prepare pnpm@10.30.3 --activate
RUN --mount=type=cache,target=/root/.local/share/pnpm/store,id=pnpm-store \
    pnpm install --frozen-lockfile

ENV BUILD_TARGET=web

RUN pnpm build:frontend

FROM python:3.13-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_CACHE_DIR=/root/.cache/uv \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    GIT_SSL_CAINFO=/etc/ssl/certs/ca-certificates.crt \
    UV_NATIVE_TLS=1 \
    UV_INSECURE_HOST="download.pytorch.org download-r2.pytorch.org pypi.org files.pythonhosted.org" \
    CC=gcc \
    PATH="/app/backend/.venv/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    ffmpeg \
    git \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app/backend

COPY backend/pyproject.toml backend/uv.lock ./

RUN --mount=type=cache,target=/root/.cache/uv,id=uv-cache \
    GIT_SSL_NO_VERIFY=1 uv sync --frozen --no-dev --no-install-project

COPY backend ./

COPY --from=frontend-build /app/dist /app/dist

RUN --mount=type=cache,target=/root/.cache/uv,id=uv-cache \
    GIT_SSL_NO_VERIFY=1 uv sync --frozen --no-dev

COPY scripts/airgap-entrypoint.sh /usr/local/bin/airgap-entrypoint.sh

RUN sed -i 's/\r$//' /usr/local/bin/airgap-entrypoint.sh \
    && chmod +x /usr/local/bin/airgap-entrypoint.sh

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=20 \
    CMD curl -fsS http://127.0.0.1:${LTX_PORT:-8000}/readyz || exit 1

ENTRYPOINT ["/usr/local/bin/airgap-entrypoint.sh"]
